--- a/styles/main.css
+++ b/styles/main.css
@@ -4,2 +4,3 @@
 :root {
+  color-scheme: light;
   /* Colors - Light Theme (Default) */
@@ -40,2 +41,3 @@
 [data-theme="dark"] {
+  color-scheme: dark;
   /* Colors - Dark Theme */
@@ -148,3 +150,4 @@
-.theme-toggle {
+.theme-toggle,
+#animation-toggle {
   display: flex;
@@ -159,3 +162,4 @@
-.theme-toggle:hover {
+.theme-toggle:hover,
+#animation-toggle:hover {
   background-color: var(--color-surface-hover);
@@ -163,3 +167,4 @@
-.theme-toggle svg {
+.theme-toggle svg,
+#animation-toggle svg {
   width: 20px;
@@ -749,2 +754,30 @@
   to { transform: rotate(360deg); }
 }
+
+/* ==========================================================================
+   Scroll-Driven Reveal Animations
+   ========================================================================== */
+@media (prefers-reduced-motion: no-preference) {
+  @supports (animation-timeline: view()) {
+    @keyframes scroll-reveal-item {
+      from {
+        opacity: 0;
+        transform: translateY(40px) scale(0.97);
+      }
+      to {
+        opacity: 1;
+        transform: translateY(0) scale(1);
+      }
+    }
+
+    @keyframes scroll-reveal-title {
+      from {
+        opacity: 0;
+        transform: translateX(-20px);
+      }
+      to {
+        opacity: 1;
+        transform: translateX(0);
+      }
+    }
+
+    html.scroll-animations-enabled .gallery-card,
+    html.scroll-animations-enabled .photo-item {
+      animation: scroll-reveal-item auto linear both;
+      animation-timeline: view();
+      animation-range: entry;
+    }
+
+    html.scroll-animations-enabled .section-title {
+      animation: scroll-reveal-title auto linear both;
+      animation-timeline: view();
+      animation-range: entry;
+    }
+  }
+}
